# Copiá este archivo a `.env` y completá con los datos de tu proyecto Supabase.
# (Dashboard → Settings → API)
#
# La ANON key es PÚBLICA por diseño: va en el frontend, la protege la RLS.
# NUNCA pongas acá la service_role key (esa bypassa la RLS, solo va server-side).
#
# El archivo `.env` está en .gitignore — no se sube al repo.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key
