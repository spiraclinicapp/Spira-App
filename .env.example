# Copiá este archivo a `.env` y completá con los datos de tu proyecto Supabase.
# (Dashboard → Settings → API)
#
# La Publishable key es PÚBLICA por diseño: va en el frontend, la protege la RLS.
# NUNCA pongas acá una Secret key / service_role (esas bypassan la RLS, solo server-side).
#
# El archivo `.env` está en .gitignore — no se sube al repo.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
