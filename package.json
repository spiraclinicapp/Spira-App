{
  "name": "spira-app",
  "private": true,
  "version": "0.116.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vitest run && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tutoriales:instalar": "npm --prefix tutoriales ci",
    "tutoriales:grabar": "npm --prefix tutoriales run grabar --",
    "tutoriales:verificar": "npm --prefix tutoriales run verificar --",
    "tutoriales:publicar": "npm --prefix tutoriales run publicar --",
    "tutoriales:tipos": "npm --prefix tutoriales run typecheck",
    "demo:verificar": "node scripts/demo/verificar.mjs",
    "demo:migrar": "node scripts/demo/migrar.mjs",
    "demo:resetear": "node scripts/demo/resetear.mjs",
    "demo:sesion": "node scripts/demo/sesion.mjs",
    "demo:app": "node scripts/demo/app.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "react": "^19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "pg": "^8.13.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
